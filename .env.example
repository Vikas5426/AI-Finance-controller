# ==============================================================================
# AI Financial Controller - Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
PORT=8000

# Database Configuration
# Default uses local SQLite for instant zero-dependency run
DATABASE_URL=sqlite:///./finance_controller.db

# For PostgreSQL in production or Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/finance_controller

# Redis Configuration (Optional ephemeral cache & distributed lock manager)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production_jwt_9921
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Optional - Deterministic Rule Reasoner activates automatically if omitted)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Storage & Materiality
UPLOAD_DIR=./data/uploads
MATERIALITY_THRESHOLD_MINOR=50000
BASE_CURRENCY=INR
