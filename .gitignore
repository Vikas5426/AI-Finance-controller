# ==============================================================================
# Recon — Git Ignore Rules
# ==============================================================================

# Environments & Secrets
.env
.env.local
.env.*
!.env.example
*.pem
*.key
*.cert

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Databases, Storage & Ephemeral Uploads
*.db
*.sqlite
*.sqlite3
finance_controller.db*
data/uploads/*
!data/uploads/.gitkeep
data/sqlite/*
!data/sqlite/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Logs & Temporary Scratch Files
*.log
logs/
_*.json
_*.py
!__init__.py
!__main__.py

# Local Tooling, Backups & IDE Metadata
.audit-out/
.backup_pre_p0_fixes/
.claude/
.gemini/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
